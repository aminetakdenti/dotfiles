font-family = "JetBrains Mono"
# theme = onyx-dark
theme = TokyoNight
window-padding-x = 10
window-padding-y = 10

keybind = alt+cmd+h=goto_split:left
keybind = alt+cmd+l=goto_split:right
keybind = alt+cmd+j=goto_split:bottom
keybind = alt+cmd+k=goto_split:top

keybind = super+ctrl+j=resize_split:down,10
keybind = super+ctrl+h=resize_split:left,10
keybind = super+ctrl+l=resize_split:right,10
keybind = super+ctrl+k=resize_split:up,10

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor

command = /opt/homebrew/bin/nu
